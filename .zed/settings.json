{
  "languages": {
    "TypeScript": {
      "language_servers": ["deno", "!typescript-language-server", "!vtsls"]
    }
  },
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true,
          "enablePaths": ["src/clients/deno"]
        }
      }
    },
    "basedpyright": {
      "settings": {
        "python.pythonPath": "src/clients/python/.venv/bin/python",
        "python.venvPath": "src/clients/python",
        "python.analysis": {
          "venvPath": "src/clients/python",
          "venv": ".venv"
        }
      }
    }
  }
}
